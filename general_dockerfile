# ------------------------------------
# Define Build Arguments (ARG) - Use explicit IDs and generic names
# ------------------------------------
ARG APP_VERSION=1.0.0
ARG HTTP_PORT=3000
ARG APP_USER=appuser    # Generic, lowercase user name
ARG APP_GROUP=appgroup  # Generic, lowercase group name
ARG APP_UID=10001       # Explicit, high UID for security/k8s

# ------------------------------------
# Stage 1: Builder Stage (Install Dependencies)
# ------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . . # <--- Must copy source files here too!

# ------------------------------------
# Stage 2: Final Runtime Stage (Slim and Secure)
# ------------------------------------
FROM node:20-slim AS final

# Promote ARG to ENV for application access
ENV PORT=${HTTP_PORT}
ENV NODE_ENV=production

# ------------------------------------
# Security: Create the Non-Root User Explicitly
# CONCEPTS: Explicit UID/GID
# ------------------------------------
RUN set -eux; \
    addgroup -g ${APP_UID} ${APP_GROUP}; \
    adduser -D -u ${APP_UID} -G ${APP_GROUP} ${APP_USER}; \
    mkdir -p /app; \
    chown -R ${APP_USER}:${APP_GROUP} /app 

WORKDIR /app
USER ${APP_USER}

# Copy artifacts from the builder stage with correct ownership
# Note the fix for the typo 'builder'
COPY --from=builder --chown=${APP_USER}:${APP_GROUP} /app/node_modules ./node_modules
COPY --from=builder --chown=${APP_USER}:${APP_GROUP} /app/server.js .

EXPOSE ${PORT} # Using the ENV variable

# ENTRYPOINT & CMD for predictable execution
ENTRYPOINT ["node"]
CMD ["server.js"]






